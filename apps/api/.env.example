# Database Configuration
# The Docker Postgres container runs on port 5433 (mapped from internal 5432)
DATABASE_URL=postgresql://appuser:apppass@localhost:5433/curriculum_engine

# Application Settings
APP_ENV=local
APP_NAME=curriculum-engine-api

# Authentication
# AUTH_MODE: "dev_header" (default, trusts X-User-Email) or "google_jwt" (verifies Google ID tokens)
AUTH_MODE=dev_header
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Embedding Configuration (optional)
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# OpenAI Settings (only if using OpenAI embeddings)
# OPENAI_API_KEY=your-key-here
